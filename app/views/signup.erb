<h2>Join Benstagram!</h2>
<main>

    <ul class="errors">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>

    <form method="POST" action="/signup">
        <div class="form-group"></div>
            <label for='email'> Email </label>
            <input placeholder="Enter your email" id="email" name="email" type="email" value="<%= @user.email %>">
    </div>

    <div class="form-group">
        <label>Avatar URL</label>
        <input type="text" id="avatar_url" name="avatar_url"  value="<%= @user.avatar_url %>">
</div>

    <div class="form-group">
        <label>Username</label>
        <input type="text" id="username" name="username" value="<%= @user.username %>">
    </div>

    <div class="form-group"></div>
        <label for="password"> Password </label>
        <input placeholder="Enter your password" id="password" name="password" type="password">
    </div>

    <div class="form-group"></div>
        <button class="button" type="submit">Signup</button>
    </div>

</form>